# Request
string dataset_root
string dataset_name
string checkpoint_path
string sam_encoder_type
int32  no_grasps
bool   seen_set

# Custom Jacquard-like / UOC-derived input options
bool   custom_no_gt
string sample_id
int32  mask_id
bool   remove_background
bool   apply_mask_to_q

---
# Response
bool   success
string message
string output_dir
graspsam_ros2/Grasp[] grasps