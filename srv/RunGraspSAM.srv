# Request
string dataset_root          # e.g. ./datasets/Jacquard_Samples/Samples/1a9fa.../
string checkpoint_path       # inside container working dir, e.g. ./pretrained_checkpoint/mobile_sam.pt
string sam_encoder_type      # vit_b, vit_t, vit_h, ...
int32  no_grasps             # top-K grasps to test (see eval.py's detect_grasps)
bool   seen_set              # optional: use --seen-set
---
# Response
bool   success
string message
string output_dir            # where eval.py wrote outputs (host path)
graspsam_ros2/Grasp[] grasps
